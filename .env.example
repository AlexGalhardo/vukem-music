APP_NAME=vukem-music
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
PORT=3000
DATABASE_URL=file:storage/database.sqlite
APP_URL=http://localhost:3000
APP_LOCALE=en
MAIL_MAILER=log
# CLI generation only. Never use a VITE_ prefix for this secret.
ELEVENLABS_API_KEY=
