{
  "version": "0.1.0",
  "packageManager": "bun@1.4.4",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "biome check --write .",
    "lint:js": "biome lint --no-errors-on-unmatched .",
    "secrets:scan": "betterleaks git --no-banner --redact",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "dev": "vite",
